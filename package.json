{
  "name": "shambawatch",
  "version": "1.0.0",
  "description": "Rift Valley Basin Environmental & Agricultural IoT Telemetry Platform",
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node tests/sensor-domain.test.js && node tests/lorawan-decoder.test.js",
    "ingest": "node scripts/ingest_telemetry.js",
    "ingest:dry": "node scripts/ingest_telemetry.js --dry-run",
